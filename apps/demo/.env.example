# Copy to .env.local for local dev (node --env-file=.env.local ...), or set
# these directly as real environment variables on your hosting platform
# (e.g. Render's dashboard — this app never loads .env.local in production,
# only real process.env values).
#
# This app's own HTTP server needs almost nothing — its real job is
# spawning apps/broker/scripts/e2e-live-demo.ts as a child process, so
# EVERYTHING that script and the sandbox agent it spawns need must be
# present here too. See src/lib/server/run-manager.ts's doc comment.

# --- Where the real, already-deployed broker lives ---
# A protocol-qualified value (http:// or https://) is used AS-IS, with NO
# port appended — a real hosted broker's HTTPS port (443) is implicit. Only
# a bare hostname gets "http://" + BROKER_PORT appended (local/dev use).
# See apps/sandbox/src/config.ts's brokerBaseUrl() for the exact rule.
BROKER_HOST=https://your-broker.onrender.com
# Only consulted when BROKER_HOST has no protocol prefix.
BROKER_PORT=3000

# --- Ledger signing: must match reality for THIS process, not the broker's ---
# e2e-live-demo.ts's preflight check looks for a reachable Speculos
# instance from wherever IT runs (this service), independent of whatever
# the remote broker itself is configured with. If this deployment has no
# Speculos/Docker (true for a plain Render web service), this MUST be
# false, or every run fails at preflight looking for 127.0.0.1:9999.
LEDGER_SIGNING_ENABLED=false

# --- Real LLM provider for the agent (apps/sandbox/src/live-run.ts) ---
GEMINI_API_KEY_1=
# Optional fallback, used only if every Gemini key is rate-limited/exhausted.
GROQ_API_KEY=

# --- Real Hedera testnet settlement + HCS audit trail ---
# Same values as the broker's own .env.local — required for the scenario
# stage's settlement-outcome verification AND for the x402 purchase stage
# (which pays using these same operator credentials directly, in-process,
# not through the broker's HTTP API — see run-manager.ts's doc comment).
HEDERA_TESTNET_ACCOUNT_ID=0.0.xxxxxx
HEDERA_TESTNET_PRIVATE_KEY=302e...
HEDERA_HCS_TOPIC_ID=0.0.xxxxxx

# --- The real x402-gated service this deployment's second stage pays ---
# Point at your already-deployed apps/gated-content-service, not localhost.
GATED_CONTENT_URL=https://your-gated-content-service.onrender.com/gated-research-snippet
GATED_CONTENT_PAYTO_ACCOUNT_ID=0.0.xxxxxx
GATED_CONTENT_PRICE_HBAR=0.001

# --- Not needed ---
# PORT: do not set. The host (Render) injects its own; SvelteKit's
# adapter-node already reads process.env.PORT.
