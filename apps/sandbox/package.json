{
  "name": "sandbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:live": "node --env-file=.env.local --import tsx/esm src/live-run.ts",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.67",
    "@ai-sdk/groq": "4.0.40",
    "@paybound/capability-spec": "workspace:*",
    "@paybound/protocol": "workspace:*",
    "ai": "7.0.92",
    "zod": "^4.5.4"
  }
}
