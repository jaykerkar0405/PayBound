# Copy to .env.local (or export these directly) before running
# `pnpm --filter sandbox dev` / `pnpm --filter sandbox start`.
# Values below match the defaults apps/sandbox/src/config.ts falls back to
# when a variable is unset.

# host.docker.internal only resolves from inside the sandbox's own Docker
# container (see Dockerfile / entrypoint.sh) and lets it reach a broker
# running on the host. Running the sandbox directly on the host (outside
# Docker, e.g. via `pnpm dev`) needs this pointed at the broker's real
# address instead, e.g. 127.0.0.1.
BROKER_HOST=host.docker.internal
BROKER_PORT=3000
NODE_ENV=development

# --- Real LLM provider (task 6.1b, live-run.ts) ---
# PLACEHOLDER — do not fill these in speculatively. Real values must come
# from whoever holds funded Gemini/Groq API keys for this project. Until
# GEMINI_API_KEY is set, live-run.ts's LIVE_RUN_MODEL=real mode fails fast
# with a clear error rather than attempting a request with no credentials;
# LIVE_RUN_MODEL=scripted (the default) never reads either of these.
# GROQ_API_KEY is only used as a fallback when the Gemini call fails
# (network error, timeout, non-OK response, unparseable output) — same
# primary/fallback pattern as the fiat402 project's ai-advisory.ts.
#
# GEMINI_API_KEY=...
# GROQ_API_KEY=gsk_...

# Which model live-run.ts uses to drive the agent loop. "scripted"
# (default) — createScriptedDecisionModel (scripted-model.ts), a fixed
# free/fast read-then-pay sequence, no API key or network call needed.
# "real" — a real model via @ai-sdk/google (Gemini, tried first) falling
# back to @ai-sdk/groq (Groq) on any Gemini failure. Requires
# GEMINI_API_KEY above (and GROQ_API_KEY for the fallback to work).
# LIVE_RUN_MODEL=scripted

# Overrides the specific model id for each provider when
# LIVE_RUN_MODEL=real. Defaults (matching fiat402's choices) if unset:
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
