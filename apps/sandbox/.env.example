# Copy to .env.local (or export these directly) before running
# `pnpm --filter sandbox dev` / `pnpm --filter sandbox start`.
# Values below match the defaults apps/sandbox/src/config.ts falls back to
# when a variable is unset.

# host.docker.internal only resolves from inside the sandbox's own Docker
# container (see Dockerfile / entrypoint.sh) and lets it reach a broker
# running on the host. Running the sandbox directly on the host (outside
# Docker, e.g. via `pnpm dev`) needs this pointed at the broker's real
# address instead, e.g. 127.0.0.1.
BROKER_HOST=host.docker.internal
BROKER_PORT=3000
NODE_ENV=development

# --- Real LLM provider (task 6.1b, live-run.ts) ---
# PLACEHOLDER — do not fill these in speculatively. Real values must come
# from whoever holds funded Gemini/Groq API keys for this project. Until
# at least GEMINI_API_KEY_1 is set, live-run.ts's LIVE_RUN_MODEL=real mode
# fails fast with a clear error rather than attempting a request with no
# credentials; LIVE_RUN_MODEL=scripted (the default) never reads any of
# these. GROQ_API_KEY is only used once EVERY configured Gemini key is
# exhausted (RPM-cooling-down or RPD-exhausted) — same primary/fallback
# pattern as the fiat402 project's ai-advisory.ts.
#
# Gemini key pool (RPM/RPD-aware rotation, gemini-key-pool.ts): up to 3
# keys, checked in order, all optional beyond the first. Works fine with
# just GEMINI_API_KEY_1 set (same as a single-key setup); each additional
# key adds rotation capacity — when one hits a per-minute rate limit, the
# next key is tried immediately rather than waiting, and only once every
# configured key is unavailable does live-run.ts fall through to Groq.
# Backward compat: if none of GEMINI_API_KEY_1/_2/_3 are set, the older
# single GEMINI_API_KEY var (PR #87/#88) is used as a one-key pool.
#
# GEMINI_API_KEY_1=...
# GEMINI_API_KEY_2=...
# GEMINI_API_KEY_3=...
# GEMINI_API_KEY=...
# GROQ_API_KEY=gsk_...

# Which model live-run.ts uses to drive the agent loop. "scripted"
# (default) — createScriptedDecisionModel (scripted-model.ts), a fixed
# free/fast read-then-pay sequence, no API key or network call needed.
# "real" — a real model via @ai-sdk/google (Gemini key pool, tried first)
# falling back to @ai-sdk/groq (Groq) once every Gemini key is
# exhausted. Requires at least GEMINI_API_KEY_1 (or GEMINI_API_KEY) above
# (and GROQ_API_KEY for the fallback to work).
# LIVE_RUN_MODEL=scripted

# Overrides the specific model id for each provider when
# LIVE_RUN_MODEL=real. GEMINI_MODEL defaults to gemini-3.5-flash-lite —
# the "flash-lite" tier is the one rate-limit research found clearing
# the required floor (15 RPM / 1,000 RPD / 250K TPM per key, on the
# gemini-2.5-flash-lite generation); the 3.5 generation is the current
# default rather than 2.5 because gemini-2.5-flash-lite returns 404
# "no longer available to new users" on newer API keys (confirmed live)
# — gemini-3.5-flash-lite worked on every key tested. GROQ_MODEL
# defaults to fiat402's own choice.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
