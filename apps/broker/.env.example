# Copy to .env.local (or export these directly) before running
# `pnpm --filter broker dev` / `pnpm --filter broker start`.
# Values below match the defaults apps/broker/src/config.ts falls back to
# when a variable is unset.
#
# NOTE: `pnpm --filter broker dev` does NOT load .env.local (confirmed
# empirically — plain `tsx`/`tsx watch` has no .env auto-loading). Use
# `pnpm --filter broker dev:live` instead when you need real credentials
# (e.g. live Hedera settlement verification) — it loads .env.local via
# Node's --env-file flag. Use plain `dev` for normal development/testing,
# where LEDGER_SIGNING_ENABLED=false or a Speculos-only setup is enough
# and no real Hedera credentials should be in play.

PORT=3000
DB_PATH=./broker.db
NODE_ENV=development

# Real Ledger-backed signer (packages/ledger-signer). Defaults to ON.
# Set to "false" to use the Phase 1 stub signer instead — no Speculos/Ledger
# needed in that case.
LEDGER_SIGNING_ENABLED=true

# BIP32-style key index passed to the Ledger Hedera app.
LEDGER_KEY_INDEX=0

# "speculos" (default) or "hid" (real hardware — documented but never run
# against real hardware in this repo; see packages/ledger-signer/README.md).
LEDGER_TRANSPORT=speculos

# Only used when LEDGER_TRANSPORT=speculos. Start Speculos first, in its own
# terminal (it needs a TTY):
#   packages/ledger-signer/speculos/start.sh
# With LEDGER_SIGNING_ENABLED=true (the default), both `pnpm --filter broker
# test` and any real POST /pay call will fail/hang without a reachable
# Speculos instance at this host/port.
LEDGER_SPECULOS_HOST=127.0.0.1
LEDGER_SPECULOS_PORT=9999

# --- Hedera Testnet settlement (@paybound/settlement, task 4.1) ---
# PLACEHOLDER — do not fill these in speculatively. Real values must come
# from whoever holds funded Hedera Testnet credentials for this project.
# Until both HEDERA_TESTNET_ACCOUNT_ID and HEDERA_TESTNET_PRIVATE_KEY are
# set, settlement.ts's isSettlementConfigured() returns false and every
# payment is deliberately left at SUBMITTED — pay() still works exactly as
# it does today, no payment gets stuck in RECOVERABLE just because these
# are unset. See docs/SETTLEMENT_INTEGRATION_PROPOSAL.md ("Design A") for
# the full design.
#
# HEDERA_TESTNET_ACCOUNT_ID=0.0.xxxxxx
# HEDERA_TESTNET_PRIVATE_KEY=302e...   # DER-encoded, per PrivateKey.fromStringDer

# PLACEHOLDER — the HCS audit-trail topic (task 4.2), created once via
# `node --import tsx/esm packages/settlement/src/hcs-topic.ts` (requires the
# two Hedera vars above to already be set) and then pasted here. Until set,
# HCS audit logging (capability issuance / authorization decisions /
# settlement outcomes) fails closed — logged and swallowed, never blocking
# the request it's attached to.
#
# HEDERA_HCS_TOPIC_ID=0.0.xxxxxx

# --- Real x402-gated content purchase (Hedera track Day 2, scripts/pay-for-gated-content.ts) ---
# apps/gated-content-service's own current configuration — this script has
# no authority over that service and must not assume these; copy them from
# apps/gated-content-service/.env.local. Requires HEDERA_TESTNET_ACCOUNT_ID/
# _PRIVATE_KEY above (the Broker pays as itself, the client role, in this
# strategy) and a running gated-content-service (`pnpm --filter
# gated-content-service dev:live`).
#
# GATED_CONTENT_URL=http://localhost:3210/gated-research-snippet
# GATED_CONTENT_PAYTO_ACCOUNT_ID=0.0.xxxxxx
# GATED_CONTENT_PRICE_HBAR=0.001

# Chainlink CRE Confidential Workflow (optional, non-load-bearing)
CRE_ENABLED=true
CRE_GATEWAY_URL=http://localhost:8080  # No service runs here by default — set this to your
                                        # local `cre workflow simulate --listen` URL (see
                                        # cre-workflow/README.md) or a real CRE gateway.
