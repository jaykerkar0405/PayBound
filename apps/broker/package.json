{
  "name": "broker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:live": "node --env-file=.env.local --import tsx/esm src/index.ts",
    "e2e:live": "node --env-file=.env.local --env-file=../sandbox/.env.local --import tsx/esm scripts/e2e-live-demo.ts",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@paybound/capability-spec": "workspace:*",
    "@paybound/ledger-signer": "workspace:*",
    "@paybound/protocol": "workspace:*",
    "@paybound/settlement": "workspace:*",
    "@paybound/x402-blocky402-client": "workspace:*",
    "hono": "^4.13.7",
    "pg": "^8.16.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.23.13"
  }
}
